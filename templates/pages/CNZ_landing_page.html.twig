{% extends 'base.html.twig' %}

{% block title %} Carbon Net Zero Solution {% endblock %}

{% block header %}
	{% embed '/includes/header.html.twig' %}
		{% block bannerarea %}{% endblock %}
	{% endembed %}
{% endblock %}

{% block body %}
	{% set maintenance = false %}

	{% if maintenance %}
		<div class="govuk-width-container">
			<main class="govuk-main-wrapper govuk-main-wrapper--l" id="main-content" role="main">
				<div class="govuk-grid-row">
					<div class="govuk-grid-column-two-thirds">
						<h1 class="govuk-heading-l">Sorry, the service is unavailable</h1>
						<p class="govuk-body">Our find a  CNZ solution service is currently down for maintenance.</p>
						<p class="govuk-body">Check back soon to use the service.</p>
						<p class="govuk-body">If you need urgent support contact our
							<a href="https://www.crowncommercial.gov.uk/contact">customer service centre</a>.</p>
					</div>
				</div>
			</main>
		</div>
	{% else %}

		<div class="govuk-width-container">
			{% include "/includes/phase_banner.html.twig" %}

			<main class="govuk-main-wrapper " id="main-content">
				<section>
					<div class="govuk-grid-row">
						<div class="govuk-grid-column-full restrict-width">
							<h1 class="govuk-heading-xl page-title">Find a carbon net zero solution</h1>
							<p class="govuk-body page-intro">Use this service to help you find a solution that can help you meet your carbon net zero goals.</p>
							<h2 class="govuk-heading-m">Before you start</h2>
							<p class="govuk-body">It may be helpful to know the following information (but this is not essential):</p>
							<ul class="govuk-list govuk-list--bullet">
								<li>the product or service you need</li>
								<li>the sector or organisation you are buying for</li>
							</ul>
							<p class="govuk-body">We will then match you to the right solution or agreement to meet your needs.</p>
							<p class="govuk-body">This service takes less than 1 minute to complete.</p>

							<a href="{{ path('guided-match-journeys')}}?q=CNZ_tools" role="button" class="govuk-button govuk-button--start govuk-!-margin-top-6 govuk-!-margin-bottom-9" onclick="pushDataLayer('start', 'Start now', null, null);" data-module="govuk-button">Start now</a>
						</div>
					</div>
				</section>
			</main>
		</div>
	{% endif %}
{% endblock %}
