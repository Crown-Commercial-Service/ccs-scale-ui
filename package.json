{
  "name": "crown-commercial-services",
  "version": "1.0.0",
  "description": "npm scripts for building and watching the Crown Commercial Services site",
  "scripts": {
    "css:mainsass:compressed": "node-sass --output-style=compressed --source-map=true assets/styles/styles.scss public/carbon-net-zero/styles/styles.min.css",
    "css:mainsass:uncompressed": "node-sass assets/styles/styles.scss public/carbon-net-zero/styles/styles.css",
    "css:sass": "npm-run-all --parallel css:mainsass:*",
    "css:autoprefixer": "npx postcss public/carbon-net-zero/styles/*.css --use autoprefixer -d public/carbon-net-zero/styles ",
    "css": "npm-run-all --sequential css:sass css:autoprefixer",
    "images:imagemin": "imagemin assets/images/* --out-dir=public/carbon-net-zero/images",
    "images:svg": "svgo --folder=assets/svg --output=public/carbon-net-zero/svg --disable='removeViewBox'",
    "images": "npm-run-all --parallel images:imagemin images:svg",
    "fonts": "shx cp -r assets/fonts/* public/carbon-net-zero/fonts",
    "js:copy-assets": "uglifyjs-folder assets/scripts/ -eo public/carbon-net-zero/scripts/ -x .js",
    "js:copygovuk-frontend": "shx cp -r node_modules/govuk-frontend/dist/govuk/govuk-frontend.min.js public/carbon-net-zero/scripts/all.js",
    "js:minifygovuk-frontend": "./node_modules/.bin/babel ./node_modules/govuk-frontend/dist/govuk/govuk-frontend.min.js --out-file public/carbon-net-zero/scripts/all.min.js --presets=@babel/preset-env --minified",
    "js": "npm-run-all -s  js:copy-assets js:copygovuk-frontend js:minifygovuk-frontend",
    "build": "npm-run-all --parallel css images fonts js",
    "prebuild": "shx rm -rf public/carbon-net-zero && shx mkdir -p public/carbon-net-zero/fonts && shx mkdir public/carbon-net-zero/images && shx mkdir public/carbon-net-zero/scripts && shx mkdir public/carbon-net-zero/scripts/libraries && shx mkdir public/carbon-net-zero/styles && shx mkdir public/carbon-net-zero/svg",
    "watch:css": "watch 'npm run css' carbon-net-zero/styles --interval=1",
    "watch:images:svg": "watch 'npm run images:svg' assets/svg --interval=1",
    "watch:images:imagemin": "watch 'npm run images:imagemin' carbon-net-zero/images --interval=1",
    "watch:fonts": "watch 'npm run fonts' carbon-net-zero/fonts --interval=1",
    "watch:js:copylibraries": "watch 'npm run js:copylibraries' assets/scripts/libraries --interval=1",
    "watch": "npm-run-all --parallel watch:* watch:*:*"
  },
  "author": "Studio 24",
  "license": "ISC",
  "dependencies": {
    "@babel/polyfill": "^7.10.4",
    "autoprefixer-cli": "^1.0.0",
    "babel-preset-vue": "^2.0.2",
    "govuk-frontend": "^5.4.0",
    "imagemin-cli": "^7.0.0",
    "node": "^14.20.1",
    "node-sass": "^7.0.3",
    "npm-run-all": "^4.1.3",
    "shx": "^0.4.0",
    "svgo": "^1.0.5",
    "uglifyjs-folder": "^3.3.0",
    "vue": "^2.6.10",
    "watch": "^1.0.2",
    "whatwg-fetch": "^3.4.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.10.5",
    "@babel/core": "^7.11.1",
    "@babel/preset-env": "^7.11.0",
    "postcss": "^8.3.6",
    "postcss-cli": "^8.3.1"
  }
}
